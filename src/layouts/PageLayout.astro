---
import BaseLayout from "./BaseLayout.astro";
import Container from "~/components/Container.astro";

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  lede?: string;
  size?: "narrow" | "default" | "wide";
  /** JSON-LD for the records this page shows, passed through to BaseLayout. */
  jsonld?: unknown;
}

const { title, eyebrow, description, lede, size = "default", jsonld } = Astro.props;
---
<BaseLayout title={title} description={description ?? lede} jsonld={jsonld}>
  <Container size={size} class="pt-8 md:pt-10 pb-2">
    {eyebrow && (
      <p class="text-xs uppercase tracking-[0.18em] text-(--color-accent) font-medium mb-2">
        {eyebrow}
      </p>
    )}
    <h1
      class="font-serif text-3xl md:text-4xl font-semibold tracking-tight text-(--color-ink) leading-[1.1]"
    >
      {title}
    </h1>
    {lede && (
      <p class="mt-3 text-base md:text-lg text-(--color-ink-muted) max-w-3xl leading-relaxed">
        {lede}
      </p>
    )}
  </Container>
  <Container size={size} class="pt-6 pb-12">
    <slot />
  </Container>
</BaseLayout>
