---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
  /** "sm" is for dense listing pages where the heading shares a row with controls. */
  size?: "sm" | "md";
  class?: string;
}
const { eyebrow, title, description, id, size = "md", class: className = "" } = Astro.props;
const titleClass =
  size === "sm"
    ? "font-serif text-xl md:text-2xl font-semibold tracking-tight text-(--color-ink) leading-tight"
    : "font-serif text-2xl md:text-3xl font-semibold tracking-tight text-(--color-ink) leading-tight";
---
<div id={id} class={`scroll-mt-20 ${size === "sm" ? "" : "mb-6"} ${className}`}>
  {eyebrow && (
    <p class="text-xs uppercase tracking-[0.18em] text-(--color-accent) font-medium mb-1.5">
      {eyebrow}
    </p>
  )}
  <h2 class={titleClass}>
    {title}
    <slot name="after-title" />
  </h2>
  {description && (
    <p class="mt-2 text-(--color-ink-muted) max-w-3xl leading-relaxed">
      {description}
    </p>
  )}
</div>
